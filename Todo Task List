"""We will create a simple 'todo list' application using Python. This application will allow users to add, view, modify, and
delete tasks from their todo list. These tasks will be saved and loaded from a csv file named tasks.csv under the data directory. Each task 
will have a priority and date associated with it. We will use a dictionary to store the tasks, where the keys will be the task names 
and the values will be a list containing the priority and date. 
"""
import csv
from pathlib import Path

tasks = {}
path = Path(__file__).resolve().parent / 'data/tasks.csv'
print(path)

def upload_tasks_to_csv():
    try:
        with open(path, mode='w', newline='') as file:
            writer = csv.writer(file)
            for task, details in tasks.items():
                writer.writerow([task] + details)
    except PermissionError:
        print("Permission denied: Unable to write to tasks.csv. Please check the file permissions.")
try:
    with open(path, mode='r', newline='') as file:
        reader = csv.reader(file)
        tasks = {row[0]: [row[1], row[2]] for row in reader}
except FileNotFoundError:
    print("tasks.csv not found. Creating a new one.")
    try:
        with open(path, "w", newline='') as file:
            pass
    except PermissionError:
        print("Permission denied: Unable to create tasks.csv. Please check the file permissions.")
except PermissionError:
    print("Permission denied: Unable to read tasks.csv. Please check the file permissions.")
    
closed = False

while not closed:
    print("\nTodo List Application")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Modify Task")
    print("4. Delete Task")
    print("5. Exit")

    choice = input("Enter your choice (1-5): ")

    if choice == '1':
        task_name = input("Enter task name: ")
        priority = input("Enter task priority (High, Medium, Low): ")
        date = input("Enter task date (YYYY-MM-DD): ")
        tasks[task_name] = [priority, date]
        upload_tasks_to_csv()
        print(f"Task '{task_name}' added successfully.")

    elif choice == '2':
        if not tasks:
            print("No tasks available.")
        else:
            for task, details in tasks.items():
                print(f"Task: {task}, Priority: {details[0]}, Date: {details[1]}")

    elif choice == '3':
        task_name = input("Enter the task name to modify: ")
        if task_name in tasks:
            new_priority = input("Enter new priority (High, Medium, Low): ")
            new_date = input("Enter new date (YYYY-MM-DD): ")
            tasks[task_name] = [new_priority, new_date]
            upload_tasks_to_csv()
            print(f"Task '{task_name}' modified successfully.")
        else:
            print(f"Task '{task_name}' not found.")

    elif choice == '4':
        task_name = input("Enter the task name to delete: ")
        if task_name in tasks:
            del tasks[task_name]
            upload_tasks_to_csv()
            print(f"Task '{task_name}' deleted successfully.")
        else:
            print(f"Task '{task_name}' not found.")

    elif choice == '5':
        closed = True
        print("Exiting the application. Goodbye!")

    else:
        print("Invalid choice. Please try again.")